config_version=5

[application]

config/name="Embercall"
config/description="Vertical slice: co-op FPV melee roguelike prototype - audio radar + Ignite synergy"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Net="*res://scripts/NetworkManager.gd"
Radar="*res://scripts/Radar.gd"

